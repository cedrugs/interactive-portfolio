#!/bin/bash
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
[[ $# == 3 && "$1" =~ ^[a-f0-9]{40}$ && "$2" =~ ^sha256:[a-f0-9]{64}$ && "$3" =~ ^sha256:[a-f0-9]{64}$ ]] || exit 64
revision=$1
image_id=$2
registry_digest=$3
state=/opt/docker/sams-valley
route=/opt/docker/traefik/dynamic/sams-valley.yml
candidate="sams-valley-${revision}"
exec 9>/run/lock/sams-valley.lock
flock -w 300 9
mkdir -p "$state"
work=$(mktemp -d "$state/incoming.XXXXXX")
trap 'rm -rf "$work"' EXIT
(ulimit -f 524288; timeout 180 gzip -dc > "$work/image.tar")
docker load --input "$work/image.tar" >/dev/null
[[ $(docker image inspect "portfolio-release:$revision" --format '{{.Id}}') == "$image_id" ]]
[[ $(docker image inspect "$image_id" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}') == "$revision" ]]
[[ $(docker image inspect "$image_id" --format '{{index .Config.Labels "org.opencontainers.image.source"}}') == https://github.com/cedrugs/interactive-portfolio ]]
current=$(cat "$state/current" 2>/dev/null || true)
if [[ "$candidate" == "$current" ]]; then
	docker exec "$candidate" wget -q -O - http://127.0.0.1:3000/version.json
	exit 0
fi
if docker container inspect "$candidate" >/dev/null 2>&1; then
	docker rm -f "$candidate" >/dev/null
fi
docker run -d --name "$candidate" --restart unless-stopped \
	--network proxy --user 101:101 --read-only --tmpfs /tmp:rw,noexec,nosuid,size=32m \
	--cap-drop ALL --security-opt no-new-privileges:true \
	--memory 256m --cpus 1 --pids-limit 128 \
	--log-opt max-size=10m --log-opt max-file=3 \
	--label com.samuelcedric.application=sams-valley "$image_id" >/dev/null
healthy=false
for _attempt in $(seq 1 30); do
	if docker exec "$candidate" wget -q -O - http://127.0.0.1:3000/version.json > "$work/version.json"; then
		if python3 -c 'import json,sys; sys.exit(json.load(open(sys.argv[1])).get("revision") != sys.argv[2])' "$work/version.json" "$revision"; then
			healthy=true
			break
		fi
	fi
	sleep 2
done
if [[ "$healthy" != true ]]; then
	docker logs --tail 30 "$candidate"
	docker rm -f "$candidate" >/dev/null
	exit 1
fi
cat > "$work/route.yml" <<ROUTE
http:
  routers:
    sams-valley:
      rule: 'Host(\`samuelcedric.com\`)'
      entryPoints: [websecure]
      service: sams-valley
      tls:
        certResolver: letsencrypt-http
  services:
    sams-valley:
      loadBalancer:
        servers:
          - url: http://${candidate}:3000
        healthCheck:
          path: /healthz
          interval: 10s
          timeout: 3s
ROUTE
if [[ -f "$route" ]]; then
	cp "$route" "$state/previous-route.yml"
fi
install -m 644 "$work/route.yml" "${route}.new"
mv "${route}.new" "$route"
routed=false
for _attempt in $(seq 1 15); do
	if curl -fsS http://127.0.0.1:8080/api/http/services/sams-valley@file > "$work/service.json"; then
		if python3 -c 'import json,sys; s=json.load(open(sys.argv[1])); sys.exit(s.get("serverStatus",{}).get("http://"+sys.argv[2]+":3000") != "UP")' "$work/service.json" "$candidate"; then
			routed=true
			break
		fi
	fi
	sleep 2
done
if [[ "$routed" != true ]]; then
	if [[ -f "$state/previous-route.yml" ]]; then
		install -m 644 "$state/previous-route.yml" "${route}.new"
		mv "${route}.new" "$route"
	else
		rm -f "$route"
	fi
	docker rm -f "$candidate" >/dev/null
	exit 1
fi
previous=$(cat "$state/previous" 2>/dev/null || true)
if [[ "$previous" =~ ^sams-valley-[a-f0-9]{40}$ && "$previous" != "$current" && "$previous" != "$candidate" ]]; then
	docker rm -f "$previous" >/dev/null 2>&1 || true
fi
printf '%s\n' "$current" > "$state/previous"
printf '%s\n' "$candidate" > "$state/current"
printf '%s\n' "$registry_digest" > "$state/image-digest"
printf '%s\n' "$revision" > "$state/revision"
printf 'Activated %s (%s)\n' "$revision" "$registry_digest"
