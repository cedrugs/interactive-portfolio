#!/bin/bash
set -euo pipefail
if [[ $# != 2 || "$1" != -c ]]; then
	exit 64
fi
if [[ "$2" =~ ^deploy\ ([a-f0-9]{40})\ (sha256:[a-f0-9]{64})\ (sha256:[a-f0-9]{64})$ ]]; then
	exec /usr/bin/sudo -n /usr/local/sbin/deploy-portfolio "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
fi
exit 64
