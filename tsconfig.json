{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
    "allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"types": [
			"vite/client",
			"node"
		],
		"paths": {
			"@/*": [
				"./*"
			]
		}
	},
	"include": [
		"src",
		"components",
		"hooks",
		"lib",
		"vite.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
